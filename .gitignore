# Large data, weights, generated outputs, and local-only folders stay out of git.

# Data: everything except the split files
/data/*
!/data/splits/

# Weights and checkpoints (pretrained downloads + our checkpoints)
/weights/

# v1 data and weights (kept inside legacy/, not in git)
/legacy/data/
/legacy/weights/

# Images and files from the stand-alone module checks
/test_outputs/
/legacy/test_outputs/

# Python, environments, notebook sessions
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
**/__marimo__/

# Editor and OS
.vscode/
.DS_Store

# Third-party model code, cloned at the commits listed in configs/backbone.yaml
/third_party/
